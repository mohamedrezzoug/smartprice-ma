# SmartPrice MA — optional configuration. Copy to `.env.local` and adjust.
# All defaults use free OpenStreetMap services (no API key).

# Reverse geocoding (GPS → city / neighborhood / address): nominatim | none
VITE_GEOCODER_PROVIDER=nominatim
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org

# Nearby supermarket discovery: overpass | none
VITE_PLACES_PROVIDER=overpass
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Map tiles for Leaflet. Use `none` to disable the map.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# A price older than N days is marked "outdated".
VITE_PRICE_OUTDATED_DAYS=30

# GPS request timeout in milliseconds.
VITE_GPS_TIMEOUT_MS=15000

# Optional price sync server (POST /prices/batch, GET /prices). Empty = local only.
VITE_API_URL=
